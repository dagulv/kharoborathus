# The Go app's env. Safe values only. Secrets live in the dev vault, see infra/README.md.
APP_URL=http://localhost:3000
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_CONNECTION_STRING=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable
HTTP_HOST=0.0.0.0:3001
INTERNAL_HTTP_HOST=0.0.0.0:3002
HTTP_CORS=*
