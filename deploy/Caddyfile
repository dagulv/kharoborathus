{$SITE_DOMAIN} {
	encode zstd gzip

	@feeds path /feeds /feeds/*
	handle @feeds {
		reverse_proxy api:3001
	}

	# The admin has no login and its remote functions live outside /admin, so the whole site needs auth.
	handle {
		basic_auth {
			{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
		}
		reverse_proxy web:3000
	}
}
