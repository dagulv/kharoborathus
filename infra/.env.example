# Copy to infra/.env, which is gitignored. Haloy reads it from the config's directory.
# Haloy rejects empty values. Drop a key's entry from haloy.yaml to leave it unset.
ADMIN_USER=admin
ADMIN_PASSWORD=<password>

POSTGRES_USER=kharoborathus
POSTGRES_PASSWORD=<password>
POSTGRES_DB=kharoborathus
POSTGRES_CONNECTION_STRING=postgresql://kharoborathus:<password>@db:5432/kharoborathus?sslmode=disable

DEEPSEEK_API_KEY=
TYPESAFE_API_KEY=
BRAVE_API_KEY=
